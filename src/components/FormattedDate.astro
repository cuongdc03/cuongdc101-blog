---
export interface Props {
  date: Date;
}

const { date } = Astro.props;
const d = new Date(date);
---

<time datetime={d.toISOString()} class="text-neutral-500 dark:text-neutral-400 text-sm">
  {
    d.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  }
</time>
