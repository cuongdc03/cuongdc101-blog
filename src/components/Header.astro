---
import { NAV_ITEMS, SOCIAL_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import GithubIcon from './GithubIcon.astro';
import { Search, Menu, X } from '@lucide/astro';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};
---

<header class="sticky top-0 z-40 w-full border-b-[1.5px] border-neutral-900 dark:border-neutral-100 bg-[#fcfbf7]/95 dark:bg-[#111113]/95 backdrop-blur-md transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo / Manga Masthead -->
    <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="Home">
      <span class="manga-stamp">VOL. 01</span>
      <div class="flex items-baseline gap-2">
        <span class="font-manga font-black text-xl tracking-tighter text-neutral-900 dark:text-white">
          CUONG.LOG
        </span>
        <span class="text-[11px] text-neutral-500 dark:text-neutral-400 font-mono hidden sm:inline">
          // DEV PORTFOLIO
        </span>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-2 text-xs font-mono font-bold">
      {
        NAV_ITEMS.map((item) => {
          const active = isCurrent(item.href);
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 transition-all ${
                active
                  ? 'bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 border border-neutral-900 dark:border-neutral-100'
                  : 'text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100 hover:bg-neutral-200/50 dark:hover:bg-neutral-800/50'
              }`}
            >
              {item.text.toUpperCase()}
            </a>
          );
        })
      }
    </nav>

    <!-- Header Actions (Search, GitHub, Theme, Mobile Menu) -->
    <div class="flex items-center gap-2">
      <!-- Search Trigger Button -->
      <button
        type="button"
        data-search-trigger
        aria-label="Search posts and topics"
        class="manga-btn-secondary px-3 py-1.5 text-xs gap-2"
      >
        <Search class="w-3.5 h-3.5" />
        <span class="hidden sm:inline font-mono font-bold">SEARCH</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 border border-neutral-300 dark:border-neutral-700 font-mono text-[10px]">⌘K</kbd>
      </button>

      <!-- GitHub Link -->
      <a
        href={SOCIAL_LINKS.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="manga-btn-secondary p-1.5 text-neutral-900 dark:text-neutral-100"
      >
        <GithubIcon class="w-4 h-4" />
      </a>

      <!-- Theme Switcher -->
      <ThemeToggle />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="manga-btn-secondary md:hidden p-1.5 text-neutral-900 dark:text-neutral-100"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <Menu id="menu-icon-open" class="w-5 h-5" />
        <X id="menu-icon-close" class="w-5 h-5 hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Nav -->
  <div id="mobile-menu" class="hidden md:hidden border-b-[1.5px] border-neutral-900 dark:border-neutral-100 bg-[#fcfbf7] dark:bg-[#111113] px-4 py-4 space-y-2">
    {
      NAV_ITEMS.map((item) => {
        const active = isCurrent(item.href);
        return (
          <a
            href={item.href}
            class={`block px-4 py-2 text-xs font-mono font-bold transition-all ${
              active
                ? 'bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 border border-neutral-900 dark:border-neutral-100'
                : 'text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800'
            }`}
          >
            {item.text.toUpperCase()}
          </a>
        );
      })
    }
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');

      if (iconOpen && iconClose) {
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      }
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
