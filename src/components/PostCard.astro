---
import FormattedDate from './FormattedDate.astro';
import { Clock } from '@lucide/astro';

export interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  body?: string;
  heroImage?: string;
}

const { id, title, description, pubDate, tags = [], body = '', heroImage } = Astro.props;

// Calculate reading time
const wordCount = body ? body.split(/\s+/g).length : 250;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const primaryTag = tags[0];
---

<article class="manga-panel group relative flex flex-col justify-between p-5 sm:p-6 bg-white dark:bg-[#18181c]">
  <div>
    {
      heroImage && (
        <div class="aspect-[16/9] w-full mb-3.5 overflow-hidden border border-neutral-900 dark:border-neutral-100 bg-neutral-100 dark:bg-neutral-800">
          <img
            src={heroImage}
            alt={title}
            loading="lazy"
            class="w-full h-full object-cover grayscale contrast-115 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-300"
          />
        </div>
      )
    }

    <!-- Top Meta Row -->
    <div class="flex items-center justify-between gap-2 text-xs mb-3 font-mono">
      <div class="flex items-center gap-2 text-[11px] text-neutral-500 dark:text-neutral-400">
        <FormattedDate date={pubDate} />
        <span>•</span>
        <span class="inline-flex items-center gap-1">
          <Clock class="w-3 h-3 text-neutral-400" />
          <span>{readingTime} MIN READ</span>
        </span>
      </div>

      {
        primaryTag && (
          <span class="manga-stamp">
            #{primaryTag}
          </span>
        )
      }
    </div>

    <!-- Title with Hover Underline -->
    <h3 class="font-manga text-lg sm:text-xl font-black text-neutral-900 dark:text-white mb-2 leading-snug">
      <a href={`/blog/${id}/`} class="after:absolute after:inset-0 focus:outline-none group-hover:underline">
        {title}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-4 leading-relaxed font-normal">
      {description}
    </p>
  </div>

  <!-- Bottom Meta Row: Tags & Read Arrow -->
  <div class="pt-3 border-t border-neutral-200 dark:border-neutral-800 flex items-center justify-between text-xs font-mono font-bold relative z-10">
    <div class="flex items-center gap-1.5 flex-wrap text-[11px] text-neutral-500 dark:text-neutral-400">
      {tags.slice(0, 3).map((tag) => (
        <span class="hover:underline">#{tag}</span>
      ))}
    </div>

    <span class="text-neutral-900 dark:text-white group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
      <span>READ</span>
      <span>→</span>
    </span>
  </div>
</article>
