---
import FormattedDate from './FormattedDate.astro';
import { BookOpen } from '@lucide/astro';

export interface Props {
  id: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  series?: {
    id: string;
    order: number;
    title?: string;
  };
  body?: string;
}

const { id, title, description, pubDate, tags = [], series, body = '' } = Astro.props;

// Calculate reading time
const wordCount = body ? body.split(/\s+/g).length : 250;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<article class="group relative flex flex-col p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white dark:bg-neutral-900/60 hover:border-blue-500/50 dark:hover:border-blue-500/50 hover:shadow-lg hover:shadow-blue-500/5 transition-all duration-200">
  <div class="flex items-center justify-between gap-2 text-xs mb-3">
    <div class="flex items-center gap-2 flex-wrap">
      <FormattedDate date={pubDate} />
      <span class="text-neutral-300 dark:text-neutral-700">•</span>
      <span class="text-neutral-500 dark:text-neutral-400">{readingTime} min read</span>
    </div>

    {
      series && (
        <a
          href={`/series/${series.id}`}
          class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/60 hover:bg-blue-100 transition-colors"
        >
          <BookOpen class="w-3 h-3" />
          <span>Part {series.order}</span>
        </a>
      )
    }
  </div>

  <h3 class="text-lg font-bold text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
    <a href={`/blog/${id}/`} class="after:absolute after:inset-0">
      {title}
    </a>
  </h3>

  <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-4 leading-relaxed">
    {description}
  </p>

  {
    tags.length > 0 && (
      <div class="mt-auto pt-3 border-t border-neutral-100 dark:border-neutral-800/60 flex items-center gap-1.5 flex-wrap z-10">
        {tags.slice(0, 4).map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="inline-flex items-center text-[11px] px-2 py-0.5 rounded-md bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    )
  }
</article>
