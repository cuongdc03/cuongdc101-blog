---
import { getCollection } from 'astro:content';
import { Layers, ChevronRight } from '@lucide/astro';

export interface Props {
  seriesId: string;
  currentOrder: number;
}

const { seriesId, currentOrder } = Astro.props;

// Fetch all posts in this series
const allSeriesPosts = await getCollection('blog', ({ data }) => {
  return !data.draft && data.series && data.series.id === seriesId;
});

// Sort by chapter order
allSeriesPosts.sort((a, b) => (a.data.series?.order ?? 0) - (b.data.series?.order ?? 0));

// Fetch series details
const allSeries = await getCollection('series');
const seriesInfo = allSeries.find((s) => s.id === seriesId);
const seriesTitle = seriesInfo?.data.title || allSeriesPosts[0]?.data.series?.title || seriesId;
---

<div class="my-8 p-5 rounded-2xl border border-blue-200 dark:border-blue-900/60 bg-blue-50/50 dark:bg-blue-950/20">
  <div class="flex items-start justify-between gap-4 mb-3">
    <div class="flex items-center gap-2">
      <div class="p-2 rounded-lg bg-blue-600 dark:bg-blue-500 text-white">
        <Layers class="w-4 h-4" />
      </div>
      <div>
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300">
          Learning Track • Chapter {currentOrder} of {allSeriesPosts.length}
        </span>
        <h4 class="text-base font-bold text-neutral-900 dark:text-white">
          <a href={`/series/${seriesId}`} class="hover:underline">
            {seriesTitle}
          </a>
        </h4>
      </div>
    </div>

    <a
      href={`/series/${seriesId}`}
      class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1 shrink-0"
    >
      <span>View Track</span>
      <ChevronRight class="w-3.5 h-3.5" />
    </a>
  </div>

  <!-- Chapters Checklist / Progress -->
  <div class="mt-4 space-y-2 border-t border-blue-200/60 dark:border-blue-900/40 pt-3">
    {
      allSeriesPosts.map((post) => {
        const order = post.data.series?.order ?? 0;
        const isCurrent = order === currentOrder;

        return (
          <a
            href={`/blog/${post.id}/`}
            class={`flex items-center justify-between p-2 rounded-xl text-sm transition-colors ${
              isCurrent
                ? 'bg-blue-600 text-white font-medium shadow-sm'
                : 'text-neutral-700 dark:text-neutral-300 hover:bg-blue-100/70 dark:hover:bg-blue-900/30'
            }`}
          >
            <div class="flex items-center gap-2.5 overflow-hidden">
              <span class={`text-xs font-mono px-1.5 py-0.5 rounded ${isCurrent ? 'bg-blue-700 text-white' : 'bg-neutral-200/80 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400'}`}>
                Part {order}
              </span>
              <span class="truncate">{post.data.title}</span>
            </div>

            {isCurrent && (
              <span class="text-[11px] uppercase tracking-wider font-bold shrink-0 ml-2 px-1.5 py-0.5 rounded bg-blue-700 text-blue-100">
                Reading
              </span>
            )}
          </a>
        );
      })
    }
  </div>
</div>
