---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SITE_TAGLINE } from '../consts';
import { ArrowRight, Tag } from '@lucide/astro';

// Fetch published posts
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Extract all unique tags
const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags)));
---

<BaseLayout title="Portfolio & Engineering Notes" description={SITE_TAGLINE}>
  <!-- Hero Section: Manga Opening Spread -->
  <section class="py-6 sm:py-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      <!-- Left: Character Bio & Specs -->
      <div class="md:col-span-7 space-y-4">
        <!-- Manga Speech Bubble -->
        <div class="inline-block">
          <div class="manga-bubble px-4 py-2 font-mono text-xs font-bold text-neutral-900 dark:text-neutral-100">
            「 Welcome to my public notebook! 」
          </div>
        </div>

        <h1 class="font-manga text-4xl sm:text-5xl font-black tracking-tight leading-tight text-neutral-900 dark:text-white">
          Cao-Cuong Do
        </h1>

        <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal">
          Full-stack engineer crafting resilient distributed systems and dissecting Linux container internals. Documenting real-world production lessons one chapter at a time.
        </p>

        <!-- Manga Spec Box -->
        <div class="border border-neutral-900 dark:border-neutral-100 p-3.5 bg-white dark:bg-neutral-900 space-y-2 text-xs font-mono max-w-lg">
          <div class="flex justify-between border-b border-neutral-200 dark:border-neutral-800 pb-1.5">
            <span class="text-neutral-500 dark:text-neutral-400">CLASS:</span>
            <span class="font-bold text-neutral-900 dark:text-neutral-100">SYSTEMS BUILDER</span>
          </div>
          <div class="flex justify-between border-b border-neutral-200 dark:border-neutral-800 pb-1.5">
            <span class="text-neutral-500 dark:text-neutral-400">BASE CAMP:</span>
            <span class="font-bold text-neutral-900 dark:text-neutral-100">SAIGON (UTC+7)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-neutral-500 dark:text-neutral-400">CURRENT QUEST:</span>
            <span class="font-bold text-neutral-900 dark:text-neutral-100">CONSENSUS & CONTAINERS</span>
          </div>
        </div>

        <!-- Manga Action Buttons -->
        <div class="pt-2 flex items-center gap-3 flex-wrap">
          <a href="/blog" class="manga-btn px-4 py-2 text-xs font-mono font-bold gap-2">
            <span>READ NOTEBOOK ↓</span>
          </a>

          <a href="/about" class="manga-btn-secondary px-4 py-2 text-xs font-mono font-bold">
            CHARACTER DOSSIER
          </a>

          <a
            href="https://github.com/cuongdc101"
            target="_blank"
            rel="noopener noreferrer"
            class="manga-btn-secondary px-3.5 py-2 text-xs font-mono font-bold"
          >
            GITHUB ↗
          </a>
        </div>
      </div>

      <!-- Right: Manga Ink Photo Panel with Screentone -->
      <div class="md:col-span-5">
        <div class="relative manga-panel p-3.5 bg-white dark:bg-[#18181c] max-w-sm mx-auto">
          <div class="absolute inset-0 screentone pointer-events-none"></div>
          <div class="relative aspect-square overflow-hidden border border-neutral-900 dark:border-neutral-100 bg-neutral-100 dark:bg-neutral-800">
            <img
              src="/images/cuong.jpg"
              alt="Cao-Cuong Do"
              class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-300"
            />
            <div class="absolute bottom-2 left-2 right-2 px-2.5 py-1 bg-neutral-900/90 dark:bg-neutral-100/90 text-[#fcfbf7] dark:text-neutral-900 text-[10px] font-mono flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>STATUS: ACTIVE</span>
              </span>
              <span>SAIGON</span>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] font-mono font-bold text-neutral-600 dark:text-neutral-400">
            <span>FIGURE 1.0 — AUTHOR</span>
            <span>SAIGON WORKSPACE</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section Divider with Centered Stamp -->
  <div class="relative py-8 flex items-center justify-center">
    <div class="absolute inset-0 flex items-center">
      <div class="w-full border-t border-neutral-900 dark:border-neutral-100"></div>
    </div>
    <span class="relative bg-[#fcfbf7] dark:bg-[#111113] px-4 font-mono text-xs font-bold tracking-widest uppercase text-neutral-900 dark:text-white">
      RECENT DISPATCHES
    </span>
  </div>

  <!-- Recent Articles Grid: Manga Panels -->
  <section class="space-y-6">
    <div class="flex items-center justify-between gap-4">
      <div class="flex items-center gap-2 font-mono text-xs text-neutral-500 dark:text-neutral-400">
        <span class="manga-stamp">LOG ARCHIVE</span>
        <span>{allPosts.length} ARTICLES RECORDED</span>
      </div>

      <a
        href="/blog"
        class="manga-btn-secondary px-3 py-1 text-xs gap-1.5"
      >
        <span>ALL NOTES ({allPosts.length})</span>
        <ArrowRight class="w-3.5 h-3.5" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        allPosts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            body={post.body}
            heroImage={post.data.heroImage}
          />
        ))
      }
    </div>
  </section>

  <!-- Topic Stickers Section -->
  {
    allTags.length > 0 && (
      <section class="my-16 manga-panel p-6 sm:p-8 bg-white dark:bg-[#18181c]">
        <div class="flex items-center justify-between gap-4 mb-4">
          <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 flex items-center gap-1.5">
            <Tag class="w-3.5 h-3.5" />
            <span>TOPIC INDEX ({allTags.length})</span>
          </h3>
          <a href="/tags" class="text-xs font-mono font-bold text-neutral-900 dark:text-white hover:underline">
            ALL TOPICS →
          </a>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
          {allTags.map((tag) => {
            const count = allPosts.filter((p) => p.data.tags.includes(tag)).length;
            return (
              <a
                href={`/tags/${tag}`}
                class="manga-stamp-outline px-2.5 py-1 text-xs font-mono font-bold hover:bg-neutral-900 hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-900 transition-colors"
              >
                <span>#{tag}</span>
                <span class="text-[10px] opacity-70 ml-1">({count})</span>
              </a>
            );
          })}
        </div>
      </section>
    )
  }
</BaseLayout>
