---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { SITE_TAGLINE } from '../consts';
import { Layers, BookOpen, ArrowRight, Sparkles, Compass } from '@lucide/astro';

// Fetch published posts and series
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = allPosts.slice(0, 4);

const allSeries = await getCollection('series');
allSeries.sort((a, b) => a.data.order - b.data.order);

// Calculate post count per series
const seriesStats = allSeries.map((s) => {
  const chapters = allPosts.filter((p) => p.data.series?.id === s.id);
  return {
    ...s,
    chapterCount: chapters.length,
  };
});

// Extract all unique tags
const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags)));
---

<BaseLayout title="Home" description={SITE_TAGLINE}>
  <!-- Hero Section -->
  <section class="py-8 sm:py-16 max-w-3xl">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-blue-50 text-blue-700 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-200 dark:border-blue-800/80 mb-6">
      <Sparkles class="w-3.5 h-3.5" />
      <span>Continuous Learning & Engineering Logs</span>
    </div>

    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-neutral-900 dark:text-white leading-[1.1] mb-6">
      Documenting ideas, system deep dives, and learning paths.
    </h1>

    <p class="text-lg sm:text-xl text-neutral-600 dark:text-neutral-300 leading-relaxed mb-8">
      Hi, I'm <strong class="text-neutral-900 dark:text-white font-semibold">Cuong</strong>. This digital space serves as my second brain: a structured collection of multi-part learning roadmaps, real-world troubleshooting notes, and architecture breakdowns.
    </p>

    <!-- Call to Actions -->
    <div class="flex items-center gap-3 flex-wrap">
      <a
        href="/series"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm shadow-md shadow-blue-500/20 transition-all hover:scale-[1.02]"
      >
        <Layers class="w-4 h-4" />
        <span>Explore Learning Tracks</span>
      </a>

      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-800 dark:text-neutral-200 font-medium text-sm transition-all"
      >
        <BookOpen class="w-4 h-4" />
        <span>Browse All Posts</span>
      </a>
    </div>
  </section>

  <!-- Featured Learning Tracks Section -->
  <section class="my-12 pt-8 border-t border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-white flex items-center gap-2.5">
          <Compass class="w-6 h-6 text-blue-600 dark:text-blue-400" />
          <span>Curated Learning Tracks</span>
        </h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
          Structured, multi-part series designed to be read sequentially.
        </p>
      </div>

      <a
        href="/series"
        class="text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        <span>View all tracks</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        seriesStats.map((s) => (
          <a
            href={`/series/${s.id}`}
            class="group p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 bg-white dark:bg-neutral-900/40 hover:border-blue-500/60 dark:hover:border-blue-500/60 hover:shadow-xl hover:shadow-blue-500/5 transition-all flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-4">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md text-xs font-semibold bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">
                  {s.data.level}
                </span>

                <span class="text-xs text-neutral-500 dark:text-neutral-400 font-mono">
                  {s.chapterCount} {s.chapterCount === 1 ? 'Chapter' : 'Chapters'}
                </span>
              </div>

              <h3 class="text-lg font-bold text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors mb-2">
                {s.data.title}
              </h3>

              <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2 leading-relaxed mb-4">
                {s.data.description}
              </p>
            </div>

            <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800/60 flex items-center justify-between text-xs font-medium text-blue-600 dark:text-blue-400">
              <span>Start Track</span>
              <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Recent Articles Section -->
  <section class="my-16 pt-8 border-t border-neutral-200 dark:border-neutral-800">
    <div class="flex items-center justify-between gap-4 mb-8">
      <div>
        <h2 class="text-2xl font-bold text-neutral-900 dark:text-white flex items-center gap-2.5">
          <BookOpen class="w-6 h-6 text-blue-600 dark:text-blue-400" />
          <span>Recent Articles & Notes</span>
        </h2>
        <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
          Latest writeups, tutorials, and practical engineering guides.
        </p>
      </div>

      <a
        href="/blog"
        class="text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
      >
        <span>View all ({allPosts.length})</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        recentPosts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            series={post.data.series}
            body={post.body}
          />
        ))
      }
    </div>
  </section>

  <!-- Topic Cloud Section -->
  {
    allTags.length > 0 && (
      <section class="my-16 p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/30">
        <h3 class="text-sm font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-4">
          Browse by Topic
        </h3>
        <div class="flex items-center gap-2 flex-wrap">
          {allTags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="px-3 py-1.5 rounded-lg text-xs font-medium bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-200 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors shadow-sm"
            >
              #{tag}
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
