---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { Search } from '@lucide/astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags
const allTags = Array.from(new Set(allPosts.flatMap((p) => p.data.tags))).sort();
---

<BaseLayout
  title="All Field Notes & Articles"
  description="Explore tutorials, engineering notes, architecture deep dives, and learning journeys."
>
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <header class="mb-10 pb-6 border-b-[1.5px] border-neutral-900 dark:border-neutral-100">
      <div class="flex items-center gap-2 mb-2">
        <span class="manga-stamp">
          ARCHIVE // FIELD DISPATCHES
        </span>
      </div>
      <h1 class="font-manga text-3xl sm:text-5xl font-black text-neutral-900 dark:text-white tracking-tight mb-3">
        Field Notes & Dispatches
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base max-w-2xl leading-relaxed font-normal">
        {allPosts.length} technical writeups covering distributed consensus, Linux container internals, developer ergonomics, and production takeaways.
      </p>

      <!-- Quick Search Trigger -->
      <div class="mt-6">
        <button
          type="button"
          data-search-trigger
          class="manga-btn-secondary w-full sm:max-w-md flex items-center justify-between gap-3 px-4 py-2.5 text-xs font-mono"
        >
          <div class="flex items-center gap-2.5">
            <Search class="w-4 h-4" />
            <span>SEARCH NOTEBOOK ENTRIES...</span>
          </div>
          <kbd class="hidden sm:inline-block px-1.5 py-0.5 border border-neutral-300 dark:border-neutral-700 font-mono text-[10px]">⌘K</kbd>
        </button>
      </div>
    </header>

    <!-- Tag Filter Bar -->
    {
      allTags.length > 0 && (
        <div class="mb-8 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none font-mono">
          <a
            href="/blog"
            class="manga-stamp px-3 py-1.5 shrink-0"
          >
            ALL ({allPosts.length})
          </a>
          {allTags.map((tag) => {
            const count = allPosts.filter((p) => p.data.tags.includes(tag)).length;
            return (
              <a
                href={`/tags/${tag}`}
                class="manga-stamp-outline px-3 py-1.5 text-xs font-bold transition-colors shrink-0 hover:bg-neutral-900 hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-900"
              >
                #{tag} <span class="opacity-70 ml-1">({count})</span>
              </a>
            );
          })}
        </div>
      )
    }

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        allPosts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            body={post.body}
            heroImage={post.data.heroImage}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
