---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
import { Target, Code } from '@lucide/astro';
import GithubIcon from '../components/GithubIcon.astro';

const learningGoals = [
  {
    topic: 'Distributed Systems & Consistency',
    status: 'In Progress',
    desc: 'Deep diving into consensus algorithms (Raft), partitioned databases, and event-driven architectures.',
  },
  {
    topic: 'Cloud-Native & Production Kubernetes',
    status: 'In Progress',
    desc: 'Custom operators, eBPF network observability, and multi-tenant cluster management.',
  },
  {
    topic: 'AI Systems Engineering',
    status: 'Exploring',
    desc: 'Autonomous coding agents, tool-augmented inference, and vector retrieval pipelines.',
  },
];

const techStack = [
  { category: 'Languages', items: ['TypeScript', 'Go', 'Python', 'SQL', 'Bash'] },
  { category: 'Cloud & DevOps', items: ['Docker', 'Kubernetes', 'Linux', 'Terraform', 'GitHub Actions'] },
  { category: 'Backend & Data', items: ['Node.js', 'PostgreSQL', 'Redis', 'Kafka', 'GraphQL'] },
  { category: 'Frontend', items: ['Astro', 'React', 'Next.js', 'Tailwind CSS'] },
];
---

<BaseLayout
  title="Character Dossier & About"
  description={`About ${SITE_AUTHOR}, learning philosophy, active roadmaps, and tech stack.`}
>
  <div class="max-w-4xl mx-auto space-y-12">
    <!-- Bio Dossier Panel -->
    <header class="manga-panel p-6 sm:p-8 relative bg-white dark:bg-[#18181c]">
      <div class="absolute inset-0 screentone pointer-events-none"></div>
      <div class="relative grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center">
        <!-- Photo with Ink Frame -->
        <div class="md:col-span-4">
          <div class="relative aspect-square overflow-hidden border border-neutral-900 dark:border-neutral-100 bg-neutral-100 dark:bg-neutral-800">
            <img
              src="/images/cuong.jpg"
              alt="Cao-Cuong Do in workspace"
              class="w-full h-full object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-300"
            />
            <div class="absolute bottom-2 left-2 right-2 px-2 py-0.5 bg-neutral-900/90 dark:bg-neutral-100/90 text-[#fcfbf7] dark:text-neutral-900 text-[10px] font-mono flex items-center justify-between">
              <span>FIGURE 1.0</span>
              <span>SAIGON</span>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between font-mono text-[10px] font-bold">
            <span class="manga-stamp">
              ORIGIN: SAIGON
            </span>
            <span class="text-neutral-500">CLASS: BUILDER</span>
          </div>
        </div>

        <!-- Bio Text -->
        <div class="md:col-span-8 space-y-4">
          <div class="inline-block">
            <div class="manga-bubble px-3.5 py-1.5 font-mono text-xs font-bold text-neutral-900 dark:text-neutral-100">
              「 Documenting the journey one commit at a time. 」
            </div>
          </div>

          <h1 class="font-manga text-3xl sm:text-4xl font-black text-neutral-900 dark:text-white tracking-tight">
            Cao-Cuong Do
          </h1>

          <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal">
            I'm a software engineer fascinated by what happens beneath the abstractions—how containers isolate processes at the kernel level, how distributed nodes agree under network partitions, and how lean software scales reliably.
          </p>

          <p class="text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed font-normal">
            This digital garden is my <strong>public laboratory and workbench</strong>. When I tackle complex systems, I break them down into practical, hands-on writeups so fellow developers can level up alongside me.
          </p>

          <div class="pt-2 flex items-center gap-3">
            <a
              href={SOCIAL_LINKS.github}
              target="_blank"
              rel="noopener noreferrer"
              class="manga-btn px-4 py-2 text-xs font-mono font-bold gap-2"
            >
              <GithubIcon class="w-4 h-4" />
              <span>GITHUB PROFILE ↗</span>
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Learning Roadmap Section: Current Quests -->
    <section class="space-y-6 pt-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <Target class="w-5 h-5 text-neutral-900 dark:text-white" />
          <h2 class="font-manga text-2xl font-black text-neutral-900 dark:text-white tracking-tight">
            Current Quests & Focus Areas
          </h2>
        </div>
        <span class="manga-stamp">
          IN-FLIGHT
        </span>
      </div>

      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 font-normal">
        Active technical research topics being forged into upcoming writeups:
      </p>

      <div class="grid grid-cols-1 gap-4">
        {
          learningGoals.map((goal) => {
            return (
              <div class="manga-panel p-5 sm:p-6 bg-white dark:bg-[#18181c]">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <h3 class="font-manga text-base sm:text-lg font-bold text-neutral-900 dark:text-white">
                    {goal.topic}
                  </h3>
                  <span class="manga-stamp-outline text-[10px] font-mono px-2 py-0.5 font-bold">
                    {goal.status}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed font-normal">
                  {goal.desc}
                </p>
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Tech Stack Section: Inventory & Gear -->
    <section class="space-y-6 pt-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <Code class="w-5 h-5 text-neutral-900 dark:text-white" />
          <h2 class="font-manga text-2xl font-black text-neutral-900 dark:text-white tracking-tight">
            Inventory & Tooling
          </h2>
        </div>
        <span class="manga-stamp">
          EQUIPPED
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          techStack.map((group) => (
            <div class="manga-panel p-5 bg-white dark:bg-[#18181c]">
              <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-3.5">
                {group.category}
              </h3>
              <div class="flex flex-wrap gap-1.5 font-mono">
                {group.items.map((item) => (
                  <span class="manga-stamp-outline px-2 py-0.5 text-[11px] font-bold">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
