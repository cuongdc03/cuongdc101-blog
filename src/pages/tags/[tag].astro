---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { ArrowLeft } from '@lucide/astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags)));

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`Posts tagged with #${tag}`}
  description={`All writeups, tutorials, and notes categorized under #${tag}`}
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs mb-6 font-mono">
      <a href="/tags" class="manga-stamp-outline px-3 py-1 flex items-center gap-1.5 transition-colors hover:bg-neutral-900 hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-900">
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>ALL TOPICS</span>
      </a>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-6 border-b-[1.5px] border-neutral-900 dark:border-neutral-100">
      <div class="flex items-center gap-2 mb-2">
        <span class="manga-stamp">
          TOPIC // #{tag.toUpperCase()}
        </span>
      </div>
      <h1 class="font-manga text-3xl sm:text-5xl font-black text-neutral-900 dark:text-white tracking-tight mb-2">
        #{tag}
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base font-normal">
        Found {posts.length} {posts.length === 1 ? 'dispatch' : 'dispatches'} recorded under this topic index.
      </p>
    </header>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            body={post.body}
            heroImage={post.data.heroImage}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
