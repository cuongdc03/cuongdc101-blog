---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { ArrowLeft, Tag } from '@lucide/astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags)));

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: allPosts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title={`Posts tagged with #${tag}`}
  description={`All writeups, tutorials, and notes categorized under #${tag}`}
>
  <div class="max-w-4xl mx-auto">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400 mb-6">
      <a href="/tags" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center gap-1">
        <ArrowLeft class="w-3.5 h-3.5" />
        <span>All Tags</span>
      </a>
    </nav>

    <!-- Header -->
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2">
        <Tag class="w-4 h-4" />
        <span>Topic Archive</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 dark:text-white tracking-tight mb-2">
        #{tag}
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400">
        Found {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this topic.
      </p>
    </header>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        posts.map((post) => (
          <PostCard
            id={post.id}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            series={post.data.series}
            body={post.body}
          />
        ))
      }
    </div>
  </div>
</BaseLayout>
