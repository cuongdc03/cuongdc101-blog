---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Tag } from '@lucide/astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Calculate tag counts
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="All Tags" description="Browse articles and notes by topic tag.">
  <div class="max-w-4xl mx-auto">
    <header class="mb-10 pb-6 border-b border-neutral-200 dark:border-neutral-800">
      <div class="flex items-center gap-2 text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-wider mb-2">
        <Tag class="w-4 h-4" />
        <span>Taxonomy</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-neutral-900 dark:text-white tracking-tight mb-3">
        Browse by Tags
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400">
        Explore articles filtered by specific technical topics and tools.
      </p>
    </header>

    <div class="flex flex-wrap gap-3">
      {
        sortedTags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}`}
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900/60 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 text-sm font-medium transition-all shadow-sm"
          >
            <span>#{tag}</span>
            <span class="px-1.5 py-0.5 rounded-md text-xs bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400">
              {count}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
