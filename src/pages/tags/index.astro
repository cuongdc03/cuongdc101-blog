---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Search } from '@lucide/astro';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

// Calculate tag counts
const tagCounts = new Map<string, number>();
allPosts.forEach((post) => {
  post.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});

const sortedTags = Array.from(tagCounts.entries()).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="All Tags & Topics" description="Browse articles and notes by topic tag.">
  <div class="max-w-4xl mx-auto">
    <header class="mb-10 pb-6 border-b-[1.5px] border-neutral-900 dark:border-neutral-100">
      <div class="flex items-center gap-2 mb-2">
        <span class="manga-stamp">
          INDEX // TOPIC DIRECTORY
        </span>
      </div>
      <h1 class="font-manga text-3xl sm:text-5xl font-black text-neutral-900 dark:text-white tracking-tight mb-3">
        Browse by Topics
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm sm:text-base max-w-2xl leading-relaxed mb-6 font-normal">
        Explore {sortedTags.length} distinct engineering topics, languages, architectures, and tools.
      </p>

      <!-- Instant Filter Input -->
      <div class="relative max-w-xs">
        <Search class="w-4 h-4 text-neutral-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
        <input
          id="tag-filter-input"
          type="text"
          placeholder="FILTER TOPICS..."
          class="w-full pl-10 pr-4 py-2 text-xs border border-neutral-900 dark:border-neutral-100 bg-white dark:bg-[#18181c] text-neutral-900 dark:text-white placeholder-neutral-400 dark:placeholder-neutral-500 font-mono shadow-[2.5px_2.5px_0px_0px_currentColor] focus:outline-none transition-all"
        />
      </div>
    </header>

    <div id="tags-grid" class="flex flex-wrap gap-3">
      {
        sortedTags.map(([tag, count]) => (
          <a
            href={`/tags/${tag}`}
            data-tag-name={tag.toLowerCase()}
            class="tag-item manga-panel flex items-center gap-2 px-3.5 py-2 font-mono text-xs font-bold bg-white dark:bg-[#18181c]"
          >
            <span>#{tag}</span>
            <span class="manga-stamp text-[10px] py-0.5 px-1.5">
              {count}
            </span>
          </a>
        ))
      }
    </div>

    <!-- Empty filtered state -->
    <div id="no-tags-found" class="hidden py-12 text-center text-neutral-500 dark:text-neutral-400">
      <p class="text-sm font-medium">No topics match your filter.</p>
    </div>
  </div>

  <script>
    function setupTagFilter() {
      const input = document.getElementById('tag-filter-input') as HTMLInputElement | null;
      const tagItems = document.querySelectorAll<HTMLElement>('.tag-item');
      const emptyState = document.getElementById('no-tags-found');

      if (!input || tagItems.length === 0) return;

      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visibleCount = 0;

        tagItems.forEach((item) => {
          const tagName = item.getAttribute('data-tag-name') || '';
          if (tagName.includes(query)) {
            item.classList.remove('hidden');
            visibleCount++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
          } else {
            emptyState.classList.add('hidden');
          }
        }
      });
    }

    setupTagFilter();
    document.addEventListener('astro:after-swap', setupTagFilter);
  </script>
</BaseLayout>
