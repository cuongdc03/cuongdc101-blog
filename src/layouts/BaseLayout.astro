---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleDate?: string;
}

const { title, description, image, articleDate } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={title} description={description} image={image} articleDate={articleDate} />
  </head>
  <body class="min-h-screen flex flex-col font-sans transition-colors">
    <!-- Accessible Skip to Content Link -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 border-2 border-neutral-900 dark:border-neutral-100 rounded-xl font-bold shadow-[2px_2px_0px_0px_currentColor] transition-transform focus:outline-none"
    >
      Skip to content
    </a>

    <Header />
    <main id="main-content" class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>
    <Footer />
    <SearchModal />

    <!-- Floating Back to Top Button -->
    <button
      id="back-to-top"
      type="button"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-30 p-2.5 rounded-xl bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 border-2 border-neutral-900 dark:border-neutral-100 shadow-[2.5px_2.5px_0px_0px_#18181b] dark:shadow-[2.5px_2.5px_0px_0px_#f4f4f5] hover:-translate-y-0.5 hover:shadow-[3.5px_3.5px_0px_0px_currentColor] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all duration-150 opacity-0 pointer-events-none translate-y-3 focus:outline-none cursor-pointer"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="m18 15-6-6-6 6"/>
      </svg>
    </button>

    <!-- UI Enhancements Scripts -->
    <script>
      function setupUIEnhancements() {
        // 1. Back to Top Button
        const backToTopBtn = document.getElementById('back-to-top');
        if (backToTopBtn) {
          const toggleBackToTop = () => {
            if (window.scrollY > 350) {
              backToTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
              backToTopBtn.classList.add('opacity-100', 'translate-y-0');
            } else {
              backToTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
              backToTopBtn.classList.remove('opacity-100', 'translate-y-0');
            }
          };

          window.addEventListener('scroll', toggleBackToTop, { passive: true });
          backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
          toggleBackToTop();
        }

        // 2. Code Copy Buttons
        const codeBlocks = document.querySelectorAll('pre');
        codeBlocks.forEach((pre) => {
          if (pre.dataset.hasCopyButton) return;
          pre.dataset.hasCopyButton = 'true';
          pre.classList.add('relative', 'group');

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className =
            'copy-btn absolute top-2.5 right-2.5 px-2 py-0.5 text-[10px] font-mono font-bold bg-neutral-900 text-[#fcfbf7] dark:bg-[#fcfbf7] dark:text-neutral-900 border border-neutral-900 dark:border-neutral-100 opacity-0 group-hover:opacity-100 transition-all flex items-center gap-1 cursor-pointer shadow-[1.5px_1.5px_0px_0px_currentColor] z-10';
          btn.innerHTML = `
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
            <span>COPY</span>
          `;

          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText || pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              btn.innerHTML = `
                <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-emerald-400 font-semibold">Copied!</span>
              `;
              setTimeout(() => {
                btn.innerHTML = `
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                  <span>Copy</span>
                `;
              }, 2000);
            } catch (err) {
              console.error('Copy failed:', err);
            }
          });

          pre.appendChild(btn);
        });
      }

      setupUIEnhancements();
      document.addEventListener('astro:after-swap', setupUIEnhancements);
    </script>
  </body>
</html>
