---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { Clock, Calendar, ChevronRight, Share2 } from '@lucide/astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
  body?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  headings = [],
  body = '',
} = Astro.props;

// Reading time calculation
const wordCount = body ? body.split(/\s+/g).length : 300;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<BaseLayout title={title} description={description} image={heroImage} articleDate={pubDate.toISOString()}>
  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 right-0 h-1 bg-neutral-900 dark:bg-neutral-100 z-50 scale-x-0" aria-hidden="true"></div>

  <!-- Breadcrumb Navigation -->
  <nav class="flex items-center gap-2 text-xs mb-6 flex-wrap font-mono">
    <a href="/" class="manga-stamp-outline px-2.5 py-1 hover:bg-neutral-900 hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-900 transition-colors">
      HOME
    </a>
    <ChevronRight class="w-3.5 h-3.5 text-neutral-400 shrink-0" />
    <a href="/blog" class="manga-stamp-outline px-2.5 py-1 hover:bg-neutral-900 hover:text-white dark:hover:bg-neutral-100 dark:hover:text-neutral-900 transition-colors">
      DISPATCHES
    </a>
  </nav>

  <!-- Post Header -->
  <header class="mb-10 pb-8 border-b-[1.5px] border-neutral-900 dark:border-neutral-100">
    <div class="flex items-center gap-2 flex-wrap text-xs mb-3 font-mono">
      {
        tags.map((tag) => (
          <a
            href={`/tags/${tag}`}
            class="manga-stamp"
          >
            #{tag}
          </a>
        ))
      }
    </div>

    <h1 class="font-manga text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-neutral-900 dark:text-white leading-[1.15] mb-4">
      {title}
    </h1>

    <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-3xl mb-6 font-normal">
      {description}
    </p>

    <!-- Meta Details & Utility Actions -->
    <div class="flex items-center justify-between gap-4 text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 flex-wrap pt-2">
      <div class="flex items-center gap-3 sm:gap-4 flex-wrap font-mono text-xs">
        <span class="inline-flex items-center gap-1.5">
          <Calendar class="w-3.5 h-3.5 text-neutral-500" />
          <FormattedDate date={pubDate} />
        </span>

        {
          updatedDate && (
            <span class="text-neutral-400">
              (Updated <FormattedDate date={updatedDate} />)
            </span>
          )
        }

        <span>•</span>

        <span class="inline-flex items-center gap-1.5">
          <Clock class="w-3.5 h-3.5 text-neutral-500" />
          <span>{readingTime} MIN READ</span>
        </span>
      </div>

      <!-- Share / Copy Link Button -->
      <button
        id="share-article-btn"
        type="button"
        class="manga-btn-secondary px-3 py-1.5 text-xs gap-1.5 font-mono"
        aria-label="Copy link to clipboard"
      >
        <Share2 class="w-3.5 h-3.5" />
        <span id="share-label">SHARE LINK</span>
      </button>
    </div>
  </header>

  <!-- Featured Hero Image (if available) -->
  {
    heroImage && (
      <div class="mb-10">
        <div class="aspect-[16/9] w-full overflow-hidden border border-neutral-900 dark:border-neutral-100 bg-neutral-100 dark:bg-neutral-800 shadow-[4px_4px_0px_0px_#111111] dark:shadow-[4px_4px_0px_0px_#fcfbf7]">
          <img
            src={heroImage}
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>
        <div class="mt-2 flex items-center justify-between text-[11px] font-mono text-neutral-500">
          <span>PLATE I. — FIELD RECORD</span>
          <span>SAIGON ARCHIVE</span>
        </div>
      </div>
    )
  }

  <!-- Content & TOC Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-12 items-start">
    <article class="min-w-0">
      {/* Main Prose Article */}
      <div class="prose prose-neutral dark:prose-invert max-w-none prose-headings:font-black prose-headings:tracking-tight prose-h2:text-2xl prose-h3:text-xl prose-a:font-bold prose-a:underline hover:prose-a:opacity-80 prose-img:rounded-xl prose-img:border prose-img:border-neutral-900 dark:prose-img:border-neutral-100 prose-img:shadow-[4px_4px_0px_0px_#111111] dark:prose-img:shadow-[4px_4px_0px_0px_#fcfbf7]">
        <slot />
      </div>
    </article>

    <!-- Right Sidebar: Sticky Table of Contents -->
    <TableOfContents headings={headings} />
  </div>

  <!-- Reading Progress, Mermaid Rendering, and Share Script -->
  <script>
    let mermaidInstance: any = null;

    async function initMermaid() {
      if (!mermaidInstance) {
        try {
          const mod = await import(/* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
          mermaidInstance = mod.default || mod;
        } catch (e) {
          const mod = await import('mermaid');
          mermaidInstance = mod.default || mod;
        }
      }
      const isDark = document.documentElement.classList.contains('dark');
      mermaidInstance.initialize({
        startOnLoad: false,
        theme: isDark ? 'dark' : 'default',
        securityLevel: 'loose',
        fontFamily: 'JetBrains Mono, monospace, sans-serif',
      });
      return mermaidInstance;
    }

    async function renderMermaidDiagrams() {
      const codeBlocks = Array.from(
        document.querySelectorAll<HTMLElement>('pre[data-language="mermaid"], pre.mermaid, code.language-mermaid')
      );

      const targetElements = Array.from(
        new Set(
          codeBlocks
            .map((el) => (el.tagName === 'CODE' ? (el.closest('pre') || el) : el))
            .filter((el): el is HTMLElement => !!el && !el.dataset.mermaidRendered)
        )
      );

      if (targetElements.length === 0) return;

      try {
        const mermaid = await initMermaid();

        for (let i = 0; i < targetElements.length; i++) {
          const pre = targetElements[i];
          
          // Clone and strip any UI elements (like copy buttons) before extracting code
          const clone = pre.cloneNode(true) as HTMLElement;
          clone.querySelectorAll('.copy-btn, button').forEach((btn) => btn.remove());
          const codeEl = clone.querySelector('code') || clone;
          const rawCode = codeEl.textContent?.trim() || '';
          if (!rawCode) continue;

          pre.dataset.mermaidRendered = 'true';
          const container = document.createElement('div');
          container.className =
            'mermaid-container my-8 flex flex-col items-center justify-center overflow-x-auto p-4 sm:p-6 bg-neutral-50 dark:bg-[#18181c] border-2 border-neutral-900 dark:border-neutral-100 shadow-[4px_4px_0px_0px_#111111] dark:shadow-[4px_4px_0px_0px_#fcfbf7] rounded-none';
          container.dataset.mermaidSource = rawCode;

          const uniqueId = `mermaid-chart-${Date.now()}-${i}`;
          try {
            const { svg } = await mermaid.render(uniqueId, rawCode);
            container.innerHTML = svg;
            const svgElement = container.querySelector('svg');
            if (svgElement) {
              svgElement.style.maxWidth = '100%';
              svgElement.style.height = 'auto';
            }
            pre.replaceWith(container);
          } catch (renderError) {
            console.error('Mermaid render error for element', i, renderError);
            pre.dataset.mermaidRendered = 'error';
            // Clean up any error element injected into DOM by Mermaid
            document.querySelectorAll('#d-mermaid-syntax-error, [id^="d-mermaid"]').forEach((el) => el.remove());
          }
        }
      } catch (err) {
        console.error('Failed to load or render Mermaid:', err);
      }
    }

    async function updateMermaidTheme() {
      const containers = Array.from(document.querySelectorAll<HTMLElement>('.mermaid-container[data-mermaid-source]'));
      if (containers.length === 0) return;

      try {
        const mermaid = await initMermaid();
        for (let i = 0; i < containers.length; i++) {
          const container = containers[i];
          const source = container.dataset.mermaidSource || '';
          if (!source) continue;
          const uniqueId = `mermaid-theme-${Date.now()}-${i}`;
          try {
            const { svg } = await mermaid.render(uniqueId, source);
            container.innerHTML = svg;
            const svgElement = container.querySelector('svg');
            if (svgElement) {
              svgElement.style.maxWidth = '100%';
              svgElement.style.height = 'auto';
            }
          } catch (e) {
            console.error('Mermaid theme update error:', e);
          }
        }
      } catch (err) {
        console.error('Failed to update Mermaid theme:', err);
      }
    }

    function setupArticleUtilities() {
      // 1. Reading Progress Bar
      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        const updateProgress = () => {
          const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
          if (totalHeight <= 0) {
            progressBar.style.transform = 'scaleX(0)';
            return;
          }
          const progress = Math.min(1, Math.max(0, window.scrollY / totalHeight));
          progressBar.style.transform = `scaleX(${progress})`;
        };

        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }

      // 2. Share / Copy Link Button
      const shareBtn = document.getElementById('share-article-btn');
      const shareLabel = document.getElementById('share-label');
      if (shareBtn && shareLabel) {
        shareBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(window.location.href);
            shareLabel.innerText = 'Copied!';
            setTimeout(() => {
              shareLabel.innerText = 'Share Link';
            }, 2000);
          } catch (err) {
            console.error('Could not copy URL:', err);
          }
        });
      }

      // 3. Render Mermaid Diagrams
      renderMermaidDiagrams();
    }

    // Observe dark mode toggles to update Mermaid charts
    let currentTheme = document.documentElement.classList.contains('dark');
    const themeObserver = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark !== currentTheme) {
        currentTheme = isDark;
        updateMermaidTheme();
      }
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    setupArticleUtilities();
    document.addEventListener('astro:after-swap', setupArticleUtilities);
  </script>
</BaseLayout>
